# En Render, esta variable la completa automáticamente la base de datos
# Postgres que crees ahí (la conectás al Web Service y aparece sola).
# En desarrollo local con Postgres propio, algo como:
# DATABASE_URL="postgresql://usuario:password@localhost:5432/afiliados?schema=public"
DATABASE_URL=""

JWT_SECRET="cambiar-por-un-secreto-largo-y-aleatorio"
JWT_EXPIRES_IN="30m"
REFRESH_TOKEN_EXPIRES_IN="7d"
PORT=4000

# URL pública del frontend publicado (Render Static Site), para que el
# backend solo acepte pedidos desde ahí. En desarrollo local, dejar vacío.
FRONTEND_URL=""
