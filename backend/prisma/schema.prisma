// Produccion (Render): PostgreSQL. Para desarrollo local segui usando
// SQLite si preferis (cambiar aqui a "sqlite" y usar un .env con
// DATABASE_URL="file:./dev.db"). En Render, DATABASE_URL la provee
// automaticamente la base de datos Postgres que crees ahi.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Branch {
  id        Int         @id @default(autoincrement())
  name      String
  active    Boolean     @default(true)
  createdAt DateTime    @default(now())
  users     User[]
  affiliates Affiliate[]

  @@map("branches")
}

model Role {
  id          Int              @id @default(autoincrement())
  name        String           @unique // "Administrador" | "Secretario"
  description String?
  users       User[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id    Int              @id @default(autoincrement())
  key   String           @unique // ej: "affiliates.create", "audit.view"
  roles RolePermission[]
  userGrants UserPermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       Int
  permissionId Int
  role         Role       @relation(fields: [roleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model User {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  passwordHash String
  fullName     String
  roleId       Int
  branchId     Int?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  role         Role     @relation(fields: [roleId], references: [id])
  branch       Branch?  @relation(fields: [branchId], references: [id])
  auditLogs    AuditLog[]
  affiliateEvents AffiliateEvent[]
  directPermissions UserPermission[]

  @@map("users")
}

// Excepciones por usuario sobre los permisos de su rol: se pueden SUMAR
// permisos (granted = true) o QUITAR permisos del rol (granted = false).
model UserPermission {
  userId       Int
  permissionId Int
  user         User       @relation(fields: [userId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])
  // true = permiso extra (se suma al rol). false = permiso QUITADO a este
  // usuario aunque su rol lo tenga.
  granted      Boolean    @default(true)

  @@id([userId, permissionId])
  @@map("user_permissions")
}

model Company {
  id          Int      @id @default(autoincrement())
  name        String
  cuit        String?
  address     String?
  phone       String?
  contactName String?
  email         String?  // correo de la empresa
  contactEmail  String?  // correo de la persona de contacto
  contactMobile String?  // celular de contacto
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  affiliates  Affiliate[]
  periods     AffiliateMembershipPeriod[]
  payments    CompanyPayment[]

  @@map("companies")
}

model Affiliate {
  id             Int      @id @default(autoincrement())
  affiliateNumber String  @unique // Nº Asociado
  firstName      String
  lastName       String
  dni            String   @unique
  cuil           String?
  birthDate      DateTime?
  address        String?  // Domicilio (calle)
  addressNumber  String?  // N° de puerta
  addressType    String?  // "Casa" | "Dpto"
  floorApt       String?  // Piso y Dpto
  locality       String?  // Localidad
  province       String?  // Provincia
  phone          String?
  email          String?
  socioType      String?  // Tipo de Socio: Activo | Adherente | Participante | Honorario | No socio
  feeAmount      Float?   // Valor de cuota
  medifeFee      Float?   // Cuota de Medife (se informa en la liquidación a la empresa)
  status         String   @default("active") // active | inactive | suspended
  branchId       Int?
  companyId      Int?     // empresa donde trabaja, para descuento por recibo de sueldo
  yacimiento     String?
  puesto         String?
  companyEntryDate  DateTime? // Fecha Ingreso (a la empresa)
  leaveDate1        DateTime? // Baja
  reEntryDate       DateTime? // Fecha Alta nuevo
  leaveDate2        DateTime? // Baja (segunda)
  activeNote        String?   // Activos (texto libre de la planilla)
  healthProvider     String?  // Obra Social
  coveragePercentage String?  // "Al 100% - 60%"
  healthProviderEntryDate DateTime? // Fecha Ingreso (a la obra social)
  registryStatus     String?  // Estado (tal cual figura en la planilla)
  membershipDate DateTime? // Fecha de Asociación (editable); si no está cargada, se usa createdAt
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  branch         Branch?  @relation(fields: [branchId], references: [id])
  company        Company? @relation(fields: [companyId], references: [id])
  events         AffiliateEvent[]
  loans          Loan[]
  dependents     Dependent[]
  services      PersonService[]
  inventoryLoans InventoryLoan[]
  periods        AffiliateMembershipPeriod[]

  @@map("affiliates")
}

// Familiares a cargo del afiliado titular (conyuge, hijos, etc.),
// importados de la misma planilla, diferenciados por la columna
// "Parentesco". Nunca se borra ninguno: nada se borra en todo el sistema.
model Dependent {
  id             Int      @id @default(autoincrement())
  affiliateId    Int
  dependentNumber String? // número de afiliado propio del familiar (si la mutual le asigna uno)
  fullName       String
  dni            String?
  cuil           String?
  parentesco     String
  active         Boolean  @default(true)
  deactivatedWithTitular Boolean @default(false) // se desactivo junto con el titular (se reactiva con el)
  socioType      String?  // Adherente | Participante | Socio Deportivo | ... (define la cuota social)
  feeAmount      Float?   // si se carga, pisa el valor de cuota del tipo de socio
  medifeFee      Float?   // cuota de Medife de este familiar (va en la liquidación a la empresa)
  birthDate      DateTime?
  healthProvider     String?
  coveragePercentage String?
  healthProviderEntryDate DateTime?
  registryStatus String?
  address        String?
  addressNumber  String?
  addressType    String?  // "Casa" | "Dpto"
  floorApt       String?
  locality       String?
  province       String?
  phone          String?
  email          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  affiliate      Affiliate @relation(fields: [affiliateId], references: [id])
  services       PersonService[]

  @@map("dependents")
}

// Etapa 2: prestamos, cuotas, pagos y mora.

model Loan {
  id                Int      @id @default(autoincrement())
  affiliateId       Int
  loanType          String   // usado como "Comercio" desde la Orden de Compra
  orderNumber       String?  @unique // Nº de Orden de Compra, ej. "A-000001166"
  amount            Float
  installmentsCount Int
  installmentValue  Float
  grantedAt         DateTime @default(now())
  status            String   @default("active") // pending | approved | active | overdue | cancelled | rejected
  cancelledAt       DateTime?
  cancellationReason String?
  createdByUserId   Int?
  affiliate         Affiliate @relation(fields: [affiliateId], references: [id])
  installments      LoanInstallment[]

  @@map("loans")
}

// Fila unica que lleva el contador correlativo de las ordenes de compra
// (para poder alinear la numeracion con la que ya venian usando en papel).
model OrderCounter {
  id         Int @id @default(1)
  nextNumber Int @default(1)

  @@map("order_counter")
}

// Valor por defecto de la cuota según el tipo de socio (Activo, Adherente,
// Participante, Socio Deportivo, Honorario). Se usa para precargar el
// campo "Valor de cuota" al dar de alta o editar un asociado; no cambia
// retroactivamente el valor ya cargado de nadie.
model MembershipFeeSetting {
  id              Int      @id @default(autoincrement())
  socioType       String   @unique
  feeAmount       Float
  updatedByUserId Int?
  updatedAt       DateTime @updatedAt

  @@map("membership_fee_settings")
}

// Una fila por cuota: permite mostrar pagadas/pendientes sin recalcular,
// y es donde se detecta la mora (cuota vencida sin pago).
model LoanInstallment {
  id          Int      @id @default(autoincrement())
  loanId      Int
  number      Int
  dueDate     DateTime
  amount      Float
  paidAmount  Float    @default(0)
  status      String   @default("pending") // pending | paid | overdue
  paidAt      DateTime?
  loan        Loan     @relation(fields: [loanId], references: [id])
  payments    LoanPayment[]
  penalties   LoanInstallmentPenalty[]

  @@map("loan_installments")
}

// Pagos reales: una cuota se puede pagar en mas de una parte.
model LoanPayment {
  id                Int      @id @default(autoincrement())
  loanInstallmentId Int
  amount            Float
  paidAt            DateTime @default(now())
  registeredByUserId Int?
  installment       LoanInstallment @relation(fields: [loanInstallmentId], references: [id])

  @@map("loan_payments")
}

// Tasa de interes por mora, configurable por el administrador.
// Nunca se pisa un valor: se cierra con effectiveTo y se crea uno nuevo,
// para que quede historial de que tasa regia en cada momento.
model InterestRateSettings {
  id              Int      @id @default(autoincrement())
  rateType        String   // daily | monthly
  rateValue       Float    // porcentaje, ej. 0.5 = 0.5%
  effectiveFrom   DateTime @default(now())
  effectiveTo     DateTime?
  createdByUserId Int?
  createdAt       DateTime @default(now())
  penalties       LoanInstallmentPenalty[]

  @@map("interest_rate_settings")
}

// Interes acumulado de una cuota en mora, calculado con la tasa vigente
// al momento en que se venció (no se recalcula si la tasa cambia despues).
model LoanInstallmentPenalty {
  id                     Int      @id @default(autoincrement())
  loanInstallmentId      Int
  interestRateSettingsId Int
  daysOverdue            Int
  penaltyAmount          Float
  calculatedAt           DateTime @default(now())
  installment            LoanInstallment @relation(fields: [loanInstallmentId], references: [id])
  rateSettings           InterestRateSettings @relation(fields: [interestRateSettingsId], references: [id])

  @@map("loan_installment_penalties")
}

// Linea de tiempo de cada afiliado (punto 4/8 del brief).
model AffiliateEvent {
  id            Int       @id @default(autoincrement())
  affiliateId   Int
  eventType     String    // affiliate_created | data_modified | loan_granted | ...
  referenceTable String?
  referenceId   Int?
  description   String
  occurredAt    DateTime  @default(now())
  createdByUserId Int?
  affiliate     Affiliate @relation(fields: [affiliateId], references: [id])
  createdBy     User?     @relation(fields: [createdByUserId], references: [id])

  @@map("affiliate_events")
}

// Convenios con Empresas y con Comercios (cada uno por separado, via
// "kind"). Es un listado propio, no depende de que la empresa ya este
// cargada como empleadora en el modelo Company.
model Agreement {
  id              Int      @id @default(autoincrement())
  kind            String   // "empresa" | "comercio"
  name            String
  details         String?  // condiciones del convenio, texto libre
  active          Boolean  @default(true)
  createdByUserId Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("agreements")
}

// Inventario simple de artículos de la mutual (herramientas, equipos,
// etc.) con historial de préstamos: a quién se le dio, cuándo, y si ya
// fue devuelto.
model InventoryItem {
  id        Int      @id @default(autoincrement())
  name      String
  quantity  Int      @default(0) // cantidad total que tiene la mutual
  unitValue Float    @default(0) // valor de una unidad (para valuar el inventario)
  trackKm   Boolean  @default(false) // vehiculos: pide kilometraje al prestar/devolver
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  loans     InventoryLoan[]
  purchases InventoryPurchase[]

  @@map("inventory_items")
}

model InventoryLoan {
  id               Int       @id @default(autoincrement())
  itemId           Int
  quantity         Int       @default(1)
  // Prestado a un asociado existente, o a cualquier persona (nombre libre).
  affiliateId      Int?
  borrowerName     String?
  deliveredAt      DateTime  @default(now())
  returnedAt       DateTime?
  notes            String?
  createdByUserId  Int?
  // Valor de la unidad al momento de entregar (para que los totales del
  // mes no cambien si despues se actualiza el valor del articulo).
  unitValueAtLoan  Float     @default(0)
  kmOut            Int?      // kilometraje al entregar (vehiculos)
  kmIn             Int?      // kilometraje al devolver (vehiculos)
  item             InventoryItem @relation(fields: [itemId], references: [id])
  affiliate        Affiliate?    @relation(fields: [affiliateId], references: [id])

  @@map("inventory_loans")
}

// Compras de articulos: suman stock y quedan registradas con su costo, para
// saber cuanto se gasto en el mes.
model InventoryPurchase {
  id              Int       @id @default(autoincrement())
  itemId          Int
  quantity        Int
  unitCost        Float
  purchasedAt     DateTime  @default(now())
  notes           String?
  createdByUserId Int?
  item            InventoryItem @relation(fields: [itemId], references: [id])

  @@map("inventory_purchases")
}

// Auditoria tecnica: solo INSERT desde la aplicacion, ningun rol puede
// editar ni borrar filas de esta tabla.
model AuditLog {
  id         Int      @id @default(autoincrement())
  userId     Int?
  action     String   // create | update | delete | login | ...
  entityType String
  entityId   Int?
  beforeData String?  // JSON serializado
  afterData  String?  // JSON serializado
  ipAddress  String?
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}

// Periodos de pertenencia: cada alta/baja queda registrada con su fecha real
// y la empresa de ese momento. El asociado es SIEMPRE el mismo registro
// (mismo historial de ordenes, pagos y eventos), aunque se reincorpore
// meses despues o en otra empresa.
model AffiliateMembershipPeriod {
  id          Int       @id @default(autoincrement())
  affiliateId Int
  companyId   Int?
  startDate   DateTime  // alta real
  endDate     DateTime? // baja (null = vigente)
  note        String?
  createdAt   DateTime  @default(now())
  affiliate   Affiliate @relation(fields: [affiliateId], references: [id])
  company     Company?  @relation(fields: [companyId], references: [id])

  @@map("affiliate_membership_periods")
}

// ---------------------------------------------------------------------
// Cobranzas por empresa y caja de ingresos / egresos
// ---------------------------------------------------------------------

// Cuentas donde se mueve el dinero (Efectivo, Banco, etc.).
model CashAccount {
  id             Int      @id @default(autoincrement())
  name           String   @unique
  openingBalance Float    @default(0) // saldo inicial al empezar a usar el sistema
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  movements      CashMovement[]
  collections    CompanyPayment[]

  @@map("cash_accounts")
}

model CashCategory {
  id        Int      @id @default(autoincrement())
  name      String
  kind      String   // income | expense
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  movements CashMovement[]

  @@unique([name, kind])
  @@map("cash_categories")
}

// Cada ingreso o egreso. Nunca se borra: un movimiento equivocado se anula
// (voided) y queda el registro con el motivo.
model CashMovement {
  id               Int       @id @default(autoincrement())
  date             DateTime
  type             String    // income | expense
  amount           Float
  concept          String
  notes            String?
  accountId        Int
  categoryId       Int?
  source           String    @default("manual") // manual | company_payment
  companyPaymentId Int?      @unique
  voided           Boolean   @default(false)
  voidedReason     String?
  voidedAt         DateTime?
  createdByUserId  Int?
  createdAt        DateTime  @default(now())
  account          CashAccount  @relation(fields: [accountId], references: [id])
  category         CashCategory? @relation(fields: [categoryId], references: [id])
  companyPayment   CompanyPayment? @relation(fields: [companyPaymentId], references: [id])
  attachments      CashAttachment[]

  @@map("cash_movements")
}

// Comprobantes (foto o PDF). Se guardan en la base de datos porque el disco
// del servicio en Render no es permanente.
model CashAttachment {
  id         Int      @id @default(autoincrement())
  movementId Int
  fileName   String
  mimeType   String
  size       Int
  data       Bytes
  createdAt  DateTime @default(now())
  movement   CashMovement @relation(fields: [movementId], references: [id])

  @@map("cash_attachments")
}

// Lo que pago una empresa por un mes (monto total). Guarda lo liquidado en ese
// momento para ver la diferencia, y que cuotas se marcaron pagas.
model CompanyPayment {
  id               Int       @id @default(autoincrement())
  companyId        Int
  month            String    // AAAA-MM
  receivedAt       DateTime
  amount           Float
  expectedAmount   Float
  accountId        Int
  markedPaid       Boolean   @default(false)
  notes            String?
  voided           Boolean   @default(false)
  voidedReason     String?
  voidedAt         DateTime?
  createdByUserId  Int?
  createdAt        DateTime  @default(now())
  company          Company   @relation(fields: [companyId], references: [id])
  account          CashAccount @relation(fields: [accountId], references: [id])
  installments     CompanyPaymentInstallment[]
  movement         CashMovement?

  @@map("company_payments")
}

model CompanyPaymentInstallment {
  id                Int @id @default(autoincrement())
  companyPaymentId  Int
  loanInstallmentId Int
  loanPaymentId     Int
  amount            Float
  companyPayment    CompanyPayment @relation(fields: [companyPaymentId], references: [id])

  @@map("company_payment_installments")
}

// Dia de cierre del resumen mensual (como una tarjeta de credito): las ordenes
// de compra hechas despues de ese dia del mes entran en el resumen siguiente.
// closingDay null = sin fecha de cierre (no se corre ninguna orden).
model StatementSetting {
  id              Int      @id @default(1)
  closingDay      Int?
  updatedByUserId Int?
  updatedAt       DateTime @updatedAt

  @@map("statement_settings")
}

// Catálogo de servicios (parametrizable desde Configuración). Cada servicio
// tiene un costo sugerido que se precarga al asignarlo a una persona.
model ServiceType {
  id            Int      @id @default(autoincrement())
  name          String   @unique
  defaultAmount Float    @default(0)
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  assignments   PersonService[]

  @@map("service_types")
}

// Servicio asignado a una persona puntual (titular o familiar), con su costo
// propio. Se detalla en la liquidación mensual a la empresa. Nunca se borra:
// al quitarlo queda inactivo.
model PersonService {
  id            Int      @id @default(autoincrement())
  serviceTypeId Int
  affiliateId   Int?     // si es del titular
  dependentId   Int?     // si es de un familiar
  amount        Float
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  endedAt       DateTime?
  serviceType   ServiceType @relation(fields: [serviceTypeId], references: [id])
  affiliate     Affiliate?  @relation(fields: [affiliateId], references: [id])
  dependent     Dependent?  @relation(fields: [dependentId], references: [id])

  @@map("person_services")
}
